{
  "name": "@avi/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --loader ts-node/esm --enable-source-maps src/index.ts",
    "start": "node dist/index.js",
    "ingest": "node --loader ts-node/esm src/cli/ingest.ts",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@avi/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "stream-json": "^1.8.0"
  },
  "optionalDependencies": {
    "duckdb-async": "^1.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/stream-json": "^1.7.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
